{
  "name": "woocommerce-grow-github-actions",
  "version": "3.0.1",
  "description": "GitHub JavaScript actions for a WooCommerce plugin repo by Grow Team.",
  "type": "module",
  "scripts": {
    "test": "node --test './actions/**/__tests__/*.test.js' './utils/__tests__/*.test.js'",
    "test:watch": "node --test --watch './actions/**/__tests__/*.test.js' './utils/__tests__/*.test.js'",
    "build": "rollup -c"
  },
  "author": "WooCommerce",
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@actions/core": "^3.0.0",
    "@actions/github": "^9.0.0",
    "semver": "^7.7.4"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "rollup": "^4.59.0"
  },
  "eslintConfig": {
    "settings": {
      "import/core-modules": [
        "eslint",
        "stylelint"
      ]
    }
  }
}
