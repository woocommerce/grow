{
  "name": "woocommerce-grow",
  "version": "0.1.0",
  "description": "This repository is a container for packages, mostly dev tools to serve the Grow Team. The packages here are too experimental or too Grow-specific to be shared Woo-wide.",
  "scripts": {
    "lint:js": "eslint --ext .js,.mjs .",
    "lint:php": "vendor/bin/phpcs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/woocommerce/grow.git"
  },
  "author": "WooCommerce",
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@babel/core": "^7.25.7",
    "@woocommerce/eslint-plugin": "^3.0.0",
    "eslint": "^8.57.1",
    "eslint-plugin-prettier": "^5.1.3",
    "prettier": "npm:wp-prettier@3.0.3",
    "typescript": "~5.1.6"
  },
  "overrides": {
    "@woocommerce/eslint-plugin": {
      "@wordpress/eslint-plugin@<23.0.0": "^23.0.0",
      "prettier": "$prettier"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "9.0.9"
    }
  }
}
